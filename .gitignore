# ==========================================
# .gitignore - EduStream Pro
# ==========================================

# Archivos del Sistema Operativo
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# Editores y Entornos de Desarrollo
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Node.js y Gestores de Paquetes
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python y Servidores Locales
__pycache__/
*.py[cod]
*$py.class
*.log

# Archivos Temporales y Caché
.cache/
tmp/
temp/
*.tmp

# Variables de Entorno y Credenciales
.env
.env.local
.env.*.local
